<Page x:Class="KuzminChudoObuv.OrderDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Состав заказа" FontFamily="Calibri" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Name="OrderInfoText" FontSize="24" FontWeight="Bold"/>
            <TextBlock Name="ClientInfoText" FontSize="16" Margin="5"/>
        </StackPanel>
        <ListView Grid.Row="1" Name="OrderItemsListView" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding StockItems.Products.ProductName}" Width="300"/>
                    <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding StockItems.Sizes.Size}" Width="100"/>
                    <GridViewColumn Header="Кол-во" DisplayMemberBinding="{Binding Quantity}" Width="100"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding PriceAtOrderTime, StringFormat={}{0:N2} ₽}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Row="2" Name="TotalText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" Margin="10"/>
    </Grid>
</Page>