<Page x:Class="KuzminChudoObuv.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Состав заказа" FontFamily="Calibri" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Name="OrderInfoText" FontSize="20" FontWeight="Bold"/>
            <TextBlock Name="ClientInfoText" FontSize="16" Margin="0,5"/>
        </StackPanel>

        <ListView Grid.Row="1" Name="ItemsListView" Margin="0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Количество" DisplayMemberBinding="{Binding Quantity}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>