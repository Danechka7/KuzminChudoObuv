<Page x:Class="KuzminChudoObuv.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина" FontFamily="Calibri" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Оформление заказа" FontSize="24" FontWeight="Bold" Margin="5"/>
        <ListView Grid.Row="1" Name="CartListView" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding ProductNameForCart}" Width="300"/>
                    <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding SizeTextForCart}" Width="100"/>
                    <GridViewColumn Header="Кол-во" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="-" Width="25" Height="25" Margin="5" Click="Minus_Click" Tag="{Binding}"/>
                                    <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Content="+" Width="25" Height="25" Margin="5" Click="Plus_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding TotalForCart, StringFormat={}{0:N2}}" Width="100"/>
                    <GridViewColumn Header="" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Удалить" Width="80" Height="25" Margin="5" Click="Remove_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Name="TotalText" FontSize="20" VerticalAlignment="Center" Margin="5"/>
            <Button Content="Оформить заказ" Width="180" Height="40" FontSize="16" Margin="20" Click="Checkout_Click" Background="#70B2AF"/>
        </StackPanel>
    </Grid>
</Page>