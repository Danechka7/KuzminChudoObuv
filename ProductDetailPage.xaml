<Page x:Class="KuzminChudoObuv.ProductDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Просмотр товара" FontFamily="Calibri" Background="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="250" Height="250" Stretch="Uniform" Source="{Binding ProductImage}"/>
        <StackPanel Grid.Column="1" Margin="20">
            <TextBlock Text="{Binding ProductName}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding Manufactures.ManufactureName, StringFormat=Производство: {0}}" FontSize="16" Margin="5"/>
            <TextBlock Text="{Binding Categories.CategoryName, StringFormat=Категория: {0}}" FontSize="16" Margin="5"/>
            <TextBlock Text="{Binding DiscountPrice, StringFormat=Цена: {0:0.00} руб.}" FontSize="20" Foreground="DarkRed" Margin="10"/>
            <TextBlock Text="{Binding ProductDescription, StringFormat=Описание: {0}}" FontSize="16" TextWrapping="Wrap" Margin="5"/>
            <TextBlock Text="{Binding ProductComposition, StringFormat=Состав: {0}}" FontSize="16" TextWrapping="Wrap" Margin="5"/>
            <TextBlock Text="Выберите размер:" FontSize="16" Margin="20"/>
            <ComboBox Name="ComboSizes" Width="200" Margin="5" DisplayMemberPath="SizeText" HorizontalAlignment="Left"/>
            <TextBlock Text="Количество:" FontSize="16" Margin="10"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="-" Width="30" Height="30" Margin="5" Click="Minus_Click"/>
                <TextBlock Name="TxtQty" Text="1" FontSize="18" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="+" Width="30" Height="30" Margin="5" Click="Plus_Click"/>
            </StackPanel>
            <Button Content="Добавить в заказ" Width="180" Height="40" FontSize="16" Margin="20" Click="AddToCart_Click" Background="#70B2AF"/>
        </StackPanel>
    </Grid>
</Page>