<Page x:Class="KuzminChudoObuv.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заказы" FontFamily="Calibri" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список заказов" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <ListView Grid.Row="1" Name="OrdersListView" MouseDoubleClick="OrdersListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="№" DisplayMemberBinding="{Binding ID_Order}" Width="80"/>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="150"/>
                    <GridViewColumn Header="ФИО Клиента" DisplayMemberBinding="{Binding Users.UserSurname}" Width="300"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>