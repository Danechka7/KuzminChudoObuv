<Page x:Class="KuzminChudoObuv.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация" FontFamily="Calibri" Background="White">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Вход в систему" FontSize="24" HorizontalAlignment="Center" Margin="10"/>
            <TextBlock Text="Логин" FontSize="16" Margin="5"/>
            <TextBox Name="LoginBox" FontSize="14" Margin="5"/>
            <Button Content="Войти" Height="30" Margin="5" Click="LoginBtn_Click" Background="#70B2AF"/>
            <Button Content="Войти как гость" Height="30" Margin="5" Click="GuestBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>