<Page x:Class="KuzminChudoObuv.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог" FontFamily="Calibri" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Name="FIOTB" FontSize="16" HorizontalAlignment="Right" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
                <TextBox Name="TBoxSearch" Width="200" Margin="5,0" TextChanged="TBoxSearch_TextChanged"/>
                <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ComboBox Name="ComboCategory" Width="150" Margin="5,0" SelectionChanged="ComboCategory_SelectionChanged"/>
                <Button Content="Корзина" Width="100" Margin="20,0,0,0" Click="CartBtn_Click" Background="#70B2AF"/>
            </StackPanel>
        </StackPanel>

        <ListView Name="ProductListView" Grid.Row="1" Margin="10" MouseDoubleClick="ProductListView_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="100" Height="100" Stretch="Uniform" Source="{Binding ProductImage}"/>
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="{Binding ManufactureName, StringFormat={}{0} | }" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ProductName}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CategoryName, StringFormat=Категория: {0}}" FontSize="14"/>
                            <TextBlock Text="{Binding QuantityText}" FontSize="14"/>
                            <TextBlock Text="{Binding ProductCost, StringFormat=Цена: {0} руб.}" FontSize="16" Foreground="DarkRed"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>