<Page x:Class="KuzminChudoObuv.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог" FontFamily="Calibri" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Name="FIOTB" FontSize="16" HorizontalAlignment="Right" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
                <TextBox Name="TBoxSearch" Width="200" Margin="5,0" TextChanged="TBoxSearch_TextChanged"/>

                <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ComboBox Name="ComboCategory" Width="150" Margin="5,0" SelectionChanged="ComboCategory_SelectionChanged"/>

                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ComboBox Name="ComboSort" Width="150" Margin="5,0" SelectionChanged="ComboSort_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="По возрастанию"/>
                    <ComboBoxItem Content="По убыванию"/>
                </ComboBox>
                <Button Content="Корзина" Width="100" Margin="20,0,0,0" Click="CartBtn_Click" Background="#70B2AF"/>
                <Button Name="OrdersBtn" Content="Все заказы" Width="120" Margin="10,0,0,0"  Click="OrdersBtn_Click" Background="#70B2AF" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>

        <ListView Name="ProductListView" Grid.Row="1" Margin="10" 
                  MouseDoubleClick="ProductListView_MouseDoubleClick"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                    <Style.Triggers>
                        <!-- Подсветка красным -->
                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                            <Setter Property="Background" Value="#FF8080"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Width="100" Height="100" Stretch="Uniform" VerticalAlignment="Center" Source="{Binding ImagePath}"/>

                            <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ManufactureName, Mode=OneWay}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text=" | " FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProductName, Mode=OneWay}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CategoryName, StringFormat=Категория: {0}, Mode=OneWay}" FontSize="14" Margin="0,15,0,0"/>
                                <!-- Выводим и "много/мало", и точное количество -->
                                <TextBlock FontSize="14">
                                    <Run Text="{Binding QuantityDisplay, StringFormat=Количество: {0} , Mode=OneWay}"/>
                                    <Run Text="{Binding TotalQty, StringFormat=(всего {0} шт.), Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ProductComposition, StringFormat=Состав: {0}, Mode=OneWay}" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10,15,10,0">
                                <Run Text="{Binding DiscountPrice, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                <Run Text=" ₽"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>