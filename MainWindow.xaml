<Window x:Class="KuzminChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь" Height="650" Width="1200"
        FontFamily="Calibri" Icon="rec/ЧудоОбувь.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Image Source="rec/ЧудоОбувь.png" HorizontalAlignment="Left" Margin="5"/>
        <TextBlock Text="Чудо Обувь" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
        <Frame Grid.Row="1" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden" Margin="5"/>
        <Button Content="Назад" Name="BtnBack" Width="175" Height="30" HorizontalAlignment="Right" Margin="5,5,5,5" Click="BtnBack_Click"/>
        <Button Name="BtnLogout" Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,5,185,5" 
                Background="#FF8080" Foreground="Black" FontWeight="Bold" FontSize="16"
                Click="BtnLogout_Click" Visibility="Collapsed"/>
    </Grid>
</Window>