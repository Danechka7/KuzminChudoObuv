<Window x:Class="KuzminChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KuzminChudoObuv"
        mc:Ignorable="d"
        Title="ЧудоОбучь" Height="600" Width="1000" FontFamily="Calibri" Icon="rec/ЧудоОбувь.ico" Background="#D2F6E7">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Text="Чудо Обувь" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="50"></TextBlock>
        <Image Source="/rec/ЧудоОбувь.png" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10"/>
        <Frame Grid.Row="1" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"></Frame>
        <Button Content="Назад" Name="BtnBack" Click="BtnBack_Click" HorizontalAlignment="Right" Margin="20"></Button>
    </Grid>
</Window>
